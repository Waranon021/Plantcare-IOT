# ตัวอย่างเท่านั้น: ตั้ง environment ให้ process/service ของ Node-RED ก่อนเริ่มทำงาน
# Node-RED ไม่โหลดไฟล์ .env นี้ให้อัตโนมัติ
PLANTCARE_INGEST_KEY=
PLANTCARE_INFLUX_HOST=localhost
PLANTCARE_INFLUX_URL=http://localhost:8086
PLANTCARE_INFLUX_HEALTH_URL=http://localhost:8086/health
PLANTCARE_MQTT_HOST=localhost
# ตั้ง token ของ InfluxDB ใน credentials editor ของ config node เท่านั้น ไม่ export ลง Git
